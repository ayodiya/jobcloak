# Test environment — values used by integration tests and CI.
# Integration tests require PostgreSQL and Redis (docker compose or services).
NODE_ENV=test

# docker compose postgres (host 15432 -> container 5432)
DATABASE_URL=postgresql://app:app@localhost:15432/jobs_applications_test?schema=public

# docker compose redis (host 6380 -> container 6379)
REDIS_URL=redis://localhost:6380

# AI is always mocked in tests; these only need to parse.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:3b

AUTOMATION_MODE=safe
JOB_MATCH_THRESHOLD=70
AUTO_APPLY_THRESHOLD=85
APPLICATION_DAILY_LIMIT=1
JOB_DISCOVERY_DAILY_LIMIT=5
APPLICATION_PREPARATION_DAILY_LIMIT=2

LOG_LEVEL=silent

API_HOST=127.0.0.1
API_PORT=3101
WEB_PORT=3001

BROWSER_DATA_DIR=./data/browser-profiles-test
BROWSER_HEADLESS=true
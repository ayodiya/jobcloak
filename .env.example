# Node
NODE_ENV=development

# PostgreSQL (docker compose maps host 15432 -> container 5432)
DATABASE_URL=postgresql://app:app@localhost:15432/jobs_applications?schema=public

# Redis (docker compose maps host 6380 -> container 6379)
REDIS_URL=redis://localhost:6380

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:3b
OLLAMA_TIMEOUT_MS=120000

# Automation
# safe | review | auto_apply
AUTOMATION_MODE=review
JOB_MATCH_THRESHOLD=70
AUTO_APPLY_THRESHOLD=85
APPLICATION_DAILY_LIMIT=10
JOB_DISCOVERY_DAILY_LIMIT=50
APPLICATION_PREPARATION_DAILY_LIMIT=20

# Observability
LOG_LEVEL=info

# Servers
API_HOST=127.0.0.1
API_PORT=3100
WEB_PORT=3000
# Allowed origin for the web dashboard when calling the API (CORS)
WEB_ORIGIN=http://127.0.0.1:3000

# Browser automation
BROWSER_DATA_DIR=./data/browser-profiles
BROWSER_HEADLESS=false
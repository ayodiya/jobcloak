{
  "name": "@jobs-app/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "generate": "prisma generate --schema prisma/schema.prisma",
    "migrate": "prisma migrate deploy --schema prisma/schema.prisma",
    "migrate:dev": "prisma migrate dev --schema prisma/schema.prisma",
    "reset": "prisma migrate reset --force --schema prisma/schema.prisma",
    "seed": "tsx prisma/seed.ts",
    "studio": "prisma studio --schema prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.7.0"
  },
  "devDependencies": {
    "prisma": "^7.10.0",
    "tsx": "^4.20.3"
  }
}